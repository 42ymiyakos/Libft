{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug run_test",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/test/run_test",
			"args": [],
			"cwd": "${workspaceFolder}/test",
			"environment": [
				{ "name": "ASAN_OPTIONS", "value": "detect_leaks=0" }
			],
			"MIMode": "gdb",
			"miDebuggerPath": "/usr/bin/gdb",
			"setupCommands": [
				{ "text": "-enable-pretty-printing", "ignoreFailures": true }
			],
			"preLaunchTask": "build debug"
		}
	]
}
